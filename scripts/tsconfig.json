{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["../apps/web/src/*"],
      "@brainstorming/sdk": ["../packages/sdk/src/index.ts"],
      "@brainstorming/sdk/*": ["../packages/sdk/src/*.ts"],
      "@brainstorming/ui": ["../packages/ui/src/index.ts"]
    },
    "tsBuildInfoFile": "../node_modules/.cache/tsc/scripts.tsbuildinfo"
  },
  "include": ["**/*.ts"]
}
