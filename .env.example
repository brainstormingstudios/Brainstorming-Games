# Brainstorming Games: every environment variable.
# Copy to .env.local for local work. Everything is optional: with no values at all the app runs
# in mock mode (local data, mock ads, local play origin), so `npm run dev` works out of the box.

# ---- Site --------------------------------------------------------------------------------
# Public URL of the site, no trailing slash. Your Cloudflare Pages domain or custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Origin that serves game builds (an R2 custom domain such as https://play.example.com). Must differ from the site.
NEXT_PUBLIC_PLAY_ORIGIN=http://localhost:4100
# Shown on the Contact page and in policies. Any inbox you read.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional social links for the footer (full URLs).
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_DISCORD=

# ---- Supabase (free plan) -------------------------------------------------------------------
# Supabase dashboard > Project Settings > API > Project URL. Leave empty for mock mode.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase dashboard > Project Settings > API > anon public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same page > service_role key. Build machine and Edge Functions only. NEVER expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Events transport: `function` (Edge Function, default) or `rpc` (direct Postgres function, saves function calls).
NEXT_PUBLIC_EVENTS_TRANSPORT=function

# ---- Edge Function secrets (set with `supabase secrets set`, not in this file) ----------------
# R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET   Cloudflare > R2 > Manage API tokens
# GAME_JWT_PRIVATE_JWK                                                `node scripts/gen-game-jwk.mjs` (ES256 private key)
# PAYOUT_ENCRYPTION_KEY                                               32 random bytes, base64 (`openssl rand -base64 32`)
# RESEND_API_KEY, MAIL_FROM                                           resend.com free tier, for parental-consent e-mails
# GITHUB_DISPATCH_TOKEN, GITHUB_REPO                                  fine-grained PAT with "Contents: write" on this repo
# PAGES_DEPLOY_HOOK_URL                                               Cloudflare Pages > Settings > Builds > Deploy hooks
# SITE_URL                                                            same as NEXT_PUBLIC_SITE_URL
# PRE_QA_CALLBACK_SECRET                                              any long random string, also a GitHub Actions secret

# ---- Ads (behind flags; leave empty until approved) -----------------------------------------
# Google AdSense publisher id, e.g. ca-pub-1234567890123456. Empty = no display ads (placeholders in dev).
NEXT_PUBLIC_ADSENSE_CLIENT=
# AdSense ad unit ids for each placement (AdSense > Ads > By ad unit).
NEXT_PUBLIC_ADSENSE_SLOT_GAME_SIDE=
NEXT_PUBLIC_ADSENSE_SLOT_RESPONSIVE=
# In-game ads: `mock` (fake 5 s ad), `adsense-h5` (needs H5 games ads approval) or `none`.
NEXT_PUBLIC_INGAME_ADS=mock

# ---- Analytics and errors (optional) ----------------------------------------------------------
# Cloudflare dashboard > Web Analytics > site token.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
# PostHog project key (optional, off when empty).
NEXT_PUBLIC_POSTHOG_KEY=
# Sentry DSN (optional, off when empty).
NEXT_PUBLIC_SENTRY_DSN=

# ---- Deployment (GitHub Actions secrets) ------------------------------------------------------
# CLOUDFLARE_API_TOKEN   Cloudflare > My Profile > API Tokens > "Edit Cloudflare Pages"
# CLOUDFLARE_ACCOUNT_ID  Cloudflare dashboard sidebar
# SUPABASE_HEALTH_URL    https://<project>.supabase.co/functions/v1/health (keep-alive cron)

# ---- Local only --------------------------------------------------------------------------------
# Write the static export somewhere other than apps/web/out.
BG_EXPORT_DIR=
# JSON catalogue used instead of Supabase by tests only. Never set in a real build.
BG_CATALOGUE_FIXTURE=
